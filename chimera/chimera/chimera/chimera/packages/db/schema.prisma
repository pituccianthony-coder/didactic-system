datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  journalEntries JournalEntry[]
  experiments    Experiment[]
  forecasts      Forecast[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model JournalEntry {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  observation  String
  hypothesis   String?
  check_plan   String?
  tags         String[]
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Experiment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  kind      String // "physics" | "hexagon" | "montecarlo"
  params    Json
  results   Json?
  createdAt DateTime @default(now())
}

model AwakeningItem {
  id           String    @id @default(uuid())
  url          String    @unique
  lang         String?
  topic        String // "simulation" | "consciousness" | "control" | "practice" | "glitch"
  title        String?
  publishedAt  DateTime?
  // geo data can be added later if needed
  createdAt    DateTime  @default(now())
}

model AuditDecision {
  id         String   @id @default(uuid())
  userId     String?
  input_hash String
  risk_level String // "low" | "medium" | "high"
  action     String // "allow" | "revise" | "block"
  rationale  String?
  createdAt  DateTime @default(now())
}

// Collective Foresight Models
model ForecastQuestion {
  id          String      @id @default(uuid())
  title       String
  resolution  String
  closesAt    DateTime
  resolved    Boolean     @default(false)
  outcome     Boolean?
  forecasts   Forecast[]
  signals     Signal[]
  createdAt   DateTime    @default(now())
}

model Forecast {
  id          String           @id @default(uuid())
  questionId  String
  question    ForecastQuestion @relation(fields: [questionId], references: [id])
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  probability Float
  rationale   String?
  createdAt   DateTime         @default(now())
}

model Signal {
  id         String           @id @default(uuid())
  questionId String
  question   ForecastQuestion @relation(fields: [questionId], references: [id])
  url        String
  label      String?
  weight     Float            @default(1.0)
  addedAt    DateTime         @default(now())
}
